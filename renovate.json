{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG N8N_VERSION=(?<currentValue>.*?)\\n"
      ],
      "depNameTemplate": "n8n",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG NODE_VERSION=(?<currentValue>\\d+)\\n"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "n8n"
      ],
      "automerge": true,
      "automergeType": "pr",
      "schedule": [
        "every weekend"
      ],
      "prPriority": 10,
      "platformAutomerge": true
    },
    {
      "matchPackageNames": [
        "n8n"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "breaking-change"
      ]
    }
  ]
}
