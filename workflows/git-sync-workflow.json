    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const workflow = $('Compare Dates').item.json;\nconst sha = $json.sha || null;\n\nconst content = JSON.stringify(workflow, null, 2) + '\\n';\nconst contentBase64 = Buffer.from(content).toString('base64');\n\nconst body = {\n  message: `chore(n8n): sync workflow '${workflow.name}' [auto-sync]`,\n  content: contentBase64,\n  branch: 'main'\n};\n\nif (sha) {\n  body.sha = sha;\n}\n\nreturn { \n  json: { \n    requestBody: body, \n    filename: workflow.filename \n  } \n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
