      "id": "daa532fa-55b4-4a63-9b0a-c15bcc68e3fe",
      "name": "Get All Workflows",
      "credentials": {
        "n8nApi": {
          "id": "6fnLt2dVUQGp0JYd",
          "name": "n8n account"
        }
