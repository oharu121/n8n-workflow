        "jsonBody": "={\n  \"message\": \"chore(n8n): remove workflow '{{ $json.name }}' [auto-sync]\",\n  \"sha\": \"{{ $('Get File SHA').item.json.sha }}\",\n  \"branch\": \"n8n-sync\"\n}",
        "options": {}
